(define cpu (make-cpu6502))
(define regs (cpu6502-registers cpu))
(define mem (cpu6502-memory cpu))

(vector-copy! bios mem 0 (vector-length bios) #xd000)
(vector-copy! forth mem 0 (vector-length forth) #x200)

(define TCONTROL_REGISTER #xc000)
(define TINPUT_CHAR #xc001)
(define TOUTPUT_CHAR #xc002)
(define TINPUT_CHAR_BIT #x80)
(define TOUTPUT_CHAR_BIT #x40)

(define stdout (current-output-port))

(define stdin 
  ;; of course this is silly, as it overflows
  (open-input-string ": sum ( n - ) 0 swap 0 do i + loop ;\n10000 sum . cr\n"))

(define (poll-terminal-device cpu)
  (let ((cr (vector-ref mem TCONTROL_REGISTER)))
    (cond ((zero? (bitwise-and cr TINPUT_CHAR_BIT))
	   (let ((c (read-char stdin)))
	     (when (eof-object? c)
	       (stop)
	       #;(error "EOF from terminal"))
	     (if (char=? c #\newline)
		 (set! c #\return)
		 (set! c (char-upcase c)))
	     (vector-set! mem TINPUT_CHAR (bitwise-and #x7f (char->integer c)))))
	  ((zero? (bitwise-and cr TOUTPUT_CHAR_BIT))
	   (write-char (integer->char
			(bitwise-and #x7f  (vector-ref mem TOUTPUT_CHAR))) 
		       stdout)))
    (vector-set! mem TCONTROL_REGISTER
		 (bitwise-ior cr (bitwise-ior TINPUT_CHAR_BIT TOUTPUT_CHAR_BIT)))))

(reset6502! cpu)

(vector-set! regs 5 0)
(vector-set! regs 6 2)

(define stop #f)

(call-with-current-continuation
 (lambda (k)
   (set! stop (lambda () (k #t)))
   (do () (#f)
     (execute6502! cpu 10)
     (poll-terminal-device cpu))))
