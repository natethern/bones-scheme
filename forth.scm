                     (if (> sum 255) (bitwise-ior P 1) (bitwise-and P 254)))
                   (set! A (byte sum))
                   (cond ((zero? (bitwise-and P 8)) (incb! T))
                         (else
                          (decb! A 102)
                          (and! P 254)
                          (when (> (bitwise-and A 15) 9) (incb! A 6))
                          (when (> (bitwise-and A 240) 144)
                                (incb! A 96)
                                (or! P 1))))
                   (zflag! P A)
                   (nflag! P A))))))
          ((254)
           (set! T 7)
           (let ((V (begin
                      (let ((x (peekw M PC)))
                        (incw! PC 2)
                        (when (and (= T 4) (not (= (hi x) (hi (+ x X)))))
                              (incb! T))
                        (+ x X)))))
             (begin
               (let ((x (+ (peek M V) 1)))
                 (poke! M V x)
                 (zflag! P x)
                 (nflag! P x)))))
          ((255) (set! T 2) (let ((V (begin 0))) (begin (void))))
          (else (error "invalid byte" b)))
        (set! c (- c T))))
    (vector-set! state 0 A)
    (vector-set! state 1 X)
    (vector-set! state 2 Y)
    (vector-set! state 3 P)
    (vector-set! state 4 S)
    (vector-set! state 5 (lo PC))
    (vector-set! state 6 (hi PC))
    (+ cycles (- 0 c))))
(begin
  (define (make-cpu6502)
    (cons (make-vector 65536 255) (vector 0 0 0 32 0 0 0)))
  (define cpu6502-memory car)
  (define cpu6502-registers cdr)
  (define (reset6502! p)
    (let ((regs (cpu6502-registers p)) (mem (cpu6502-memory p)))
      (vector-set! regs 0 0)
      (vector-set! regs 1 0)
      (vector-set! regs 2 0)
      (vector-set! regs 3 32)
      (vector-set! regs 4 255)
      (vector-set! regs 5 (vector-ref mem 65532))
      (vector-set! regs 6 (vector-ref mem 65533))))
  (define (interrupt6502! p vec)
    (let* ((regs (cpu6502-registers p))
           (mem (cpu6502-memory p))
           (S (vector-ref regs 4))
           (PC (+ 1
                  (bitwise-ior
                    (vector-ref regs 5)
                    (arithmetic-shift (vector-ref regs 6) 8)))))
      (vector-set! mem (+ 256 S) (arithmetic-shift PC -8))
      (vector-set! mem (+ 255 S) (bitwise-and 255 PC))
      (vector-set! mem (+ 254 S) (vector-ref regs 3))
      (vector-set! regs 3 (bitwise-ior (vector-ref regs 3) 4))
      (vector-set! regs 4 (bitwise-and 255 (- S 3)))
      (vector-set! regs 5 (vector-ref mem vec))
      (vector-set! regs 6 (vector-ref mem (bitwise-and 255 (+ vec 1))))))
  (define (execute6502! p cycles)
    (let ((M (cpu6502-memory p)) (regs (cpu6502-registers p)))
      (let loop ()
        (let ((c2 (core6502 (or cycles 999999) M regs)))
          (if cycles c2 (loop)))))))

