BONES                                                                     -*- Org -*-
=====


* work around nasm-limitation in =__float64__= literals
  - nasm doesn't accept an integer, but we could output the raw ieee
    data by extracting the values has two words.
* test file:copy.scm
* add f64vectors
   - FLOATVECTOR_TYPE (#x12)
   - would need proper alignment on 32-bit systems.
   - put API into file:fastmath.scm
   - adapt printer + reader.
* start with ARM port
* add bytevectors
  - interchangable with strings.
  - make-bytevector, bytevector?, bytevector, bytevector-u8-ref, bytevector-u8-set!,
    bytevector-length, bytevector-copy, bytevector-copy!
  - "u8(...)" read-syntax + printing.
* go through r7rs and look for possibly useful primitives
* potential optimizations
** we could coalesce allocations inside a lambda
  - but will probably gain very little.
** implement basic known procedure optimizations
  - beta-contraction (needs knowledge about FVs).
  - direct-calls (implies loops).
  - perhaps a bit of constant-propagation.
** TODO [#C] improve inlining manifest lambdas
  - don't bind temporaries for arguments that are variables or literals.
  - not that easy: we have to replace variable-references for the
    dropped llist-variables.
    - assignment must disable replacement.
** TODO [#C] implement simple copy-propagation
   - variables (same scope), and atomic literals (chars, booleans, numbers, null).
   - would solve problems related to [[inlining manifest lambdas]]
   - need 2 passes: 1st to identify assigned vars, 2nd to propagate.
** unboxing
  - "($the TYPE EXP)" annotates with type.
  - "let" can check for "$the" and assign FP-register.
  - accessing variables in FP-registers needs to move them to normal registers.
  - requires special intrinsics for FP arguments.
  - implement primitives as "($typed-case-lambda (((VAR TYPE) ...) BODY ...) ...)"
    - specially handled in operator position during canonicalization.
  - have local FA pass ("lfa") that expands $typed-case-lambda according to inferred
    types and convert "let"-bound flonum vars using a custom binding form
    - e.g. "($let-float ...)" or something like this.
* try using libgc as 2nd heap generation
  - needs write-barrier to record assignments of heap-data into non-heap objects.
    - then evict recursively.
  - also, keep GC-count in block header.
* implement eval/repl
  - could start with a simplification from grass.
  - keep it simply, without environments.
  - install signal-handlers for SIGSEGV/SIGBUS/SIGILL/SIGFPE.
* TODO [#C] pre-allocated chars in the range 0-255
  - all chars are preallocated, unless we allow chars with arbitrary code.
  - =integer->char=: check range and alloc, ensure this is inlined.
  - benchmark. 
* TODO we need FP num/str conversion
  - atof: http://pastebin.com/prYRrseH
    #+BEGIN_SRC asm
; atof implementation using SSE
;
; Gamozo Labs (C) 2013
; <bfalk@gamozolabs.com>

[bits 64]

section .data

align 8
strf: db "105.2304", 0

align 16
mulp: dd 10.0, 0, 0, 0
divp: dd  0.1, 0, 0, 0

align 8
clut:
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFE, 0xFF,
db 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
db 0x08, 0x09, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
db 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,

section .code

global mainCRTStartup
mainCRTStartup:
	mov rcx, 1000000000

.benchmark:

	; Set rbx to point to the floating point string
	mov rbx, qword strf

	; Initialize values we use a lot
	xor     rax, rax         ; Holds the digit to be converted to a float
	mov     rdi, qword clut  ; char -> dec LUT
	xorps  xmm0, xmm0        ; Holds the value being computed
	mov     rdx, qword mulp
	movdqa xmm2, oword [rdx] ; Holds 10.0 to multiply by
	mov     rdx, qword divp
	movdqa xmm3, oword [rdx] ; Holds  0.1 to multiply by

.lewp:
	mulps xmm4, xmm3 ; Shift the decimal

	mov al, byte [rbx]  ; Get the letter
	mov al, [rdi + rax] ; Convert the letter to a number using the LUT
	cmp al, 0xFF        ; If it's not a number or '.', get out
	je  short .out
	cmp al, 0xFE        ; If it's not a '.', skip the decimal handling stuff
	jne short .nodec

	movdqa xmm4, xmm2   ; In the decimal handler, put 10.0, this is a bit of a
                        ; hack as it's set to 1.0 upon the next iteration of
                        ; lewp, which is what we need.

	inc rbx             ; Increment the pointer and handle the next character
	jmp short .lewp

.nodec:
	mulss    xmm0, xmm2 ; Multiply the current value by 10.0
	movd     xmm1, eax  ; Move the digit into an xmm register
	cvtdq2ps xmm1, xmm1 ; Convert the integer to a float
	addss    xmm0, xmm1 ; Add this new character to the computed value

	inc rbx             ; Increment the pointer and handle the next character
	jmp short .lewp

.out:
	mulps xmm0, xmm4 ; Multiply the result by the decimal shift value

	dec rcx
	jnz short .benchmark

	ret
  #+END_SRC
* implement peephole pass
  - e.g. "mov rax, rsi; mov rsi, rax" happens a lot.
* implement sexpr-"peephole" pass?
  - match expressions for certain cases.
  - perhaps add "($comment COMMENT EXP)" special form to detect particular
    primitive expansions (like "not").
  - examples:
    (if (if X TRUE FALSE) Y Z) -> (if X Y Z)
    (if (if X FALSE TRUE) Y Z) -> (if X Z Y)
  - drop =let= with empty set of bindings.
* TODO =string->number= does not parse "+/-nan.0"/"+/-inf.0"
* Issues
** "inexact->exact" uses "fisttp", so needs SSE3
** i don't fully trust that "integer?" handles all cases correctly
   - is the exponent overflow-test correct?
** align flonums so that block-data is at 16-byte boundary
   - this is supposed to be faster.
   - but needs to be handled in GC (skip padding bytes.)
   - also needed for 32-bit variant with flonum support
     - when allocating flonums, align ALLOC first.
     - GC: when copying, insert marker word before flonum; during scan,
       check for marker word and skip.
** there is no way to access =locals= from other modules or host programs
** something is wrong with musl's "sprintf" (or varargs) implementation
  - "(number->string (expt 2.1 3))" returns "nan".
  - ok with glibc.
** precision of 16 in num2str produces sometimes garbage digits
   - see file:r5rs_pitfalls.scm, where test 8.1 is printed as "8.1..."
   - but precision 15 does not match result of =integer?=, which
     might be inaccurate or needs to be less accurate. This shows
     up when num->str generates a string with ".", but the =integer?=
     test returns true (thus appending another ".0")
* Referencess
