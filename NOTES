* TODO code for "asin"
  - http://forums.codeguru.com/showthread.php?262979-How-to-compute-asin
    fld   st(0)             ;copy sine value
    fmul  st,st(0)          ;sin^2
    fld1
    fsubr                   ;1-sin^2 = cos^2
    fsqrt                   ;->cos
    fpatan                  ;i.e. arctan(sin/cos) = arcsin
  - more
    Function ArcSin(X As Double) As Double
	ArcSin = Atn(X / Sqr(-X * X + 1))
    End Function

    Function ArcCos(X As Double) As Double
	ArcCos = Atn(-X / Sqr(-X * X + 1)) + 2 * Atn(1)
    End Function

    Private Sub Command1_Click()
	' replace the 0.5 below with the degree (in radians) that
	' you want to calculate its ArcSin or ArcCos value
	MsgBox "ArcSin(0.5) = " & ArcSin(0.5)
	MsgBox "ArcCos(0.5) = " & ArcCos(0.5)
    End Sub
