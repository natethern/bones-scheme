#!/bin/scheme /grass/16/boot
;;;; expand bones.scm program definition into a single file -*- Scheme -*-


(require 'sh 'match 'normalize)


(match-let (((in out) (command-line-arguments)))
  (let* ((prg (load-program in expand))
	 (nprg (normalize prg)))
    (with-output-to-file out
      (lambda ()
	(pp (car nprg))))))

